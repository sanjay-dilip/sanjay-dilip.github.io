---
import { getCollection } from "astro:content";
import VaultLayout from "../../layouts/VaultLayout.astro";
import TagChip from "../../components/TagChip.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

const allTags = Array.from(new Set(projects.flatMap((p) => p.data.tags))).sort();
---
<VaultLayout title="Projects" description="Case studies of Sanjay Dilip's featured analytics, data engineering, and ML/AI projects.">
  <div class="page-content">
    <h1>Projects</h1>
    <p>Featured case studies, ordered by relevance to analytics, data engineering, and applied ML/AI roles.</p>

    <div class="graph-preview">
      <canvas id="projects-graph-preview-canvas" aria-hidden="true"></canvas>
      <a href="/graph" class="graph-preview__cta">Open full graph view &rarr;</a>
    </div>

    <div class="tag-filter" role="group" aria-label="Filter projects by tag">
      <button type="button" class="tag-filter__button" data-tag="all" data-active="true">All</button>
      {allTags.map((tag) => (
        <button type="button" class="tag-filter__button" data-tag={tag}>#{tag}</button>
      ))}
    </div>

    <ul class="project-list">
      {projects.map((project) => (
        <li class="project-card" data-tags={project.data.tags.join(",")}>
          <a href={`/projects/${project.id}`} class="project-card__title">
            {project.data.title}
          </a>
          <p class="project-card__summary">{project.data.summary}</p>
          <p class="project-card__tags">
            {project.data.tags.map((tag) => (
              <TagChip tag={tag} />
            ))}
          </p>
        </li>
      ))}
    </ul>
  </div>
</VaultLayout>

<style>
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 1.5rem;
  }

  .tag-filter__button {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }

  .tag-filter__button:hover,
  .tag-filter__button:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .tag-filter__button[data-active="true"] {
    background: var(--tag-bg);
    border-color: var(--tag-border);
    color: var(--accent);
    font-weight: 600;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    background: var(--bg-elevated);
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card__title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--fg);
  }

  .project-card__title:hover,
  .project-card__title:focus-visible {
    color: var(--accent);
    text-decoration: none;
  }

  .project-card__summary {
    color: var(--fg-muted);
    margin: 0.4rem 0 0.6rem;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }

  .graph-preview {
    position: relative;
    margin: 1rem 0 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  #projects-graph-preview-canvas {
    display: block;
    width: 100%;
    height: 280px;
    cursor: grab;
  }

  #projects-graph-preview-canvas[data-dragging="true"] {
    cursor: grabbing;
  }

  .graph-preview__cta {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--tag-border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .graph-preview__cta:hover,
  .graph-preview__cta:focus-visible {
    background: var(--tag-bg);
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .graph-preview {
      display: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var buttons = document.querySelectorAll(".tag-filter__button");
    var cards = document.querySelectorAll(".project-card");
    if (!buttons.length) return;

    buttons.forEach(function (button) {
      button.addEventListener("click", function () {
        var tag = button.getAttribute("data-tag");
        buttons.forEach(function (b) {
          b.setAttribute("data-active", b === button ? "true" : "false");
        });
        cards.forEach(function (card) {
          var tags = (card.getAttribute("data-tags") || "").split(",");
          card.hidden = tag !== "all" && tags.indexOf(tag) === -1;
        });
      });
    });
  });
</script>

<script>
  import { initGraphCanvas } from "../../lib/graph-canvas";

  if (!window.matchMedia("(max-width: 767px)").matches) {
    const canvas = document.getElementById("projects-graph-preview-canvas") as HTMLCanvasElement | null;
    if (canvas) initGraphCanvas(canvas);
  }
</script>
