---
import { getCollection } from "astro:content";
import VaultLayout from "../layouts/VaultLayout.astro";
import { buildConnectionsSummary } from "../lib/graph-fallback";

const projects = await getCollection("projects");
const connections = buildConnectionsSummary(projects);
---
<VaultLayout title="Graph" description="A force-directed graph of Sanjay Dilip's featured projects and their shared tags.">
  <div class="page-content">
    <h1>Graph</h1>
    <p>
      A small, self-contained view of how the featured projects connect through shared tags.
      Drag nodes to reposition, hover to see connections, click a project to open its case study,
      or click a tag to filter down to what it touches.
    </p>

    <div class="graph-canvas-wrap">
      <canvas id="graph-canvas" aria-hidden="true"></canvas>
    </div>

    <div class="graph-fallback">
      <h2>Project connections</h2>
      <p>
        A plain-text list of the same connections shown in the graph above, for screen readers
        and small screens where the interactive canvas isn't shown.
      </p>
      <ul>
        {connections.map((entry) => (
          <li>
            <strong>{entry.title}</strong>
            {entry.connectionLabels.length > 0 && (
              <> &mdash; connects to: {entry.connectionLabels.join(", ")}</>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</VaultLayout>

<style>
  .graph-canvas-wrap {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  #graph-canvas {
    display: block;
    width: 100%;
    height: 65vh;
    min-height: 420px;
    cursor: grab;
  }

  #graph-canvas[data-dragging="true"] {
    cursor: grabbing;
  }

  .graph-fallback {
    margin-top: 1.5rem;
  }

  .graph-fallback ul {
    padding-left: 1.25rem;
  }

  .graph-fallback li {
    margin: 0.4rem 0;
  }

  /* Desktop: the canvas is the primary experience. The fallback list stays
     in the DOM (and the accessibility tree) for screen-reader users, but is
     visually hidden rather than removed, since the canvas itself is
     aria-hidden and offers no equivalent text alternative. */
  @media (min-width: 768px) {
    .graph-fallback {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  /* Mobile: canvas is cramped and inaccessible here, so it's removed
     entirely (not just visually) and the plain list takes its place. */
  @media (max-width: 767px) {
    .graph-canvas-wrap {
      display: none;
    }
  }
</style>

<script>
  import { initGraphCanvas } from "../lib/graph-canvas";

  const MOBILE_BREAKPOINT_QUERY = "(max-width: 767px)";

  // Mobile shows the plain-list fallback instead; skip fetching data and
  // running the simulation entirely rather than just hiding the canvas.
  if (!window.matchMedia(MOBILE_BREAKPOINT_QUERY).matches) {
    const canvas = document.getElementById("graph-canvas") as HTMLCanvasElement | null;
    if (canvas) initGraphCanvas(canvas);
  }
</script>
