---
import VaultLayout from "../layouts/VaultLayout.astro";
import Callout from "../components/Callout.astro";

const resumePdfPath = "/resume-placeholder.pdf";
---
<VaultLayout title="Resume" description="Sanjay Dilip's resume.">
  <div class="page-content">
    <h1>Resume</h1>

    <Callout variant="note" title="Placeholder">
      <p>The final resume PDF hasn't been added yet — this page currently shows a placeholder.</p>
    </Callout>

    <p>
      <a class="download-link" href={resumePdfPath} download>Download PDF →</a>
    </p>

    <embed
      src={resumePdfPath}
      type="application/pdf"
      class="resume-embed"
      aria-label="Resume PDF preview"
    />
    <p class="resume-fallback">
      If the preview above doesn't load in your browser,
      <a href={resumePdfPath}>open the PDF directly</a>.
    </p>
  </div>
</VaultLayout>

<style>
  .download-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--tag-border);
    background: var(--tag-bg);
    color: var(--accent);
    border-radius: var(--radius);
    font-weight: 600;
  }

  .download-link:hover,
  .download-link:focus-visible {
    text-decoration: none;
    background: var(--tag-border);
  }

  .resume-embed {
    width: 100%;
    height: 80vh;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .resume-fallback {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
</style>
