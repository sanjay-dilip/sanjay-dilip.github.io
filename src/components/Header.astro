---
import ThemeToggle from "./ThemeToggle.astro";

const quickLinks = [
  { href: "https://github.com/sanjay-dilip", label: "GitHub", external: true },
  { href: "https://www.linkedin.com/in/sanjaydilip", label: "LinkedIn", external: true },
  { href: "/resume", label: "Resume", external: false },
  { href: "/contact", label: "Contact", external: false },
];
---
<header class="site-header">
  <button
    id="sidebar-toggle"
    class="sidebar-toggle"
    type="button"
    aria-label="Toggle navigation"
    aria-controls="sidebar"
    aria-expanded="true"
  >
    <span aria-hidden="true">&#9776;</span>
  </button>

  <a href="/" class="site-title">Sanjay Dilip</a>

  <nav class="quick-links" aria-label="Quick links">
    <ul>
      {quickLinks.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <ThemeToggle />
</header>

<div id="sidebar-backdrop" class="sidebar-backdrop" hidden></div>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 30;
  }

  .site-title {
    font-weight: 700;
    color: var(--fg);
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .site-title:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .sidebar-toggle {
    display: inline-flex;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg);
    font-size: 1.1rem;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
  }

  .quick-links {
    margin-left: auto;
    min-width: 0;
  }

  .quick-links ul {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  .quick-links a {
    color: var(--fg);
    font-size: 0.9rem;
  }

  .quick-links a:hover,
  .quick-links a:focus-visible {
    color: var(--accent);
  }

  .sidebar-backdrop {
    display: none;
  }

  @media (max-width: 767px) {
    .quick-links {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .quick-links::-webkit-scrollbar {
      display: none;
    }

    .quick-links ul {
      gap: 0.85rem;
    }

    .sidebar-backdrop[data-open="true"] {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      z-index: 35;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var toggle = document.getElementById("sidebar-toggle");
    var sidebar = document.getElementById("sidebar");
    var backdrop = document.getElementById("sidebar-backdrop");
    if (!toggle || !sidebar || !backdrop) return;

    var mobileQuery = window.matchMedia("(max-width: 767px)");

    function setOpen(open) {
      var wasOpen = sidebar.getAttribute("data-open") === "true";
      sidebar.setAttribute("data-open", open ? "true" : "false");
      backdrop.setAttribute("data-open", open ? "true" : "false");
      backdrop.hidden = !open;
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      if (!open && wasOpen && sidebar.contains(document.activeElement)) {
        toggle.focus();
      }
    }

    function setCollapsed(collapsed) {
      document.documentElement.setAttribute(
        "data-sidebar-collapsed",
        collapsed ? "true" : "false"
      );
      sidebar.setAttribute("aria-hidden", collapsed ? "true" : "false");
      toggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
      try {
        localStorage.setItem("vault-sidebar-collapsed", collapsed ? "true" : "false");
      } catch (e) {}
    }

    toggle.setAttribute(
      "aria-expanded",
      document.documentElement.getAttribute("data-sidebar-collapsed") === "true"
        ? "false"
        : "true"
    );

    toggle.addEventListener("click", function () {
      if (mobileQuery.matches) {
        var isOpen = sidebar.getAttribute("data-open") === "true";
        setOpen(!isOpen);
      } else {
        var isCollapsed = document.documentElement.getAttribute("data-sidebar-collapsed") === "true";
        setCollapsed(!isCollapsed);
      }
    });

    backdrop.addEventListener("click", function () {
      setOpen(false);
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape") setOpen(false);
    });
  });
</script>
